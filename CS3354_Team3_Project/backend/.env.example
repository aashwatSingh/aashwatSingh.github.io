# ProjectForge backend configuration. Copy to backend/.env and adjust.
# Every value is optional: with nothing set, the backend uses a local SQLite file
# (backend/projectforge.db), seeds the demo team and runs in demo mode.

# development | production. Production requires JWT_SECRET and turns demo mode off by default.
ENVIRONMENT=development

# PostgreSQL / Supabase connection string. Leave empty for the zero-config SQLite demo.
# Supabase: Project Settings -> Database -> Connection string (URI), e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Fall back to SQLite when the Postgres URL above cannot be reached.
DB_FALLBACK_TO_SQLITE=true
# SQLite file used when no DATABASE_URL is set.
# SQLITE_PATH=./projectforge.db

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty in development, a random secret is stored in backend/.dev_jwt_secret.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480
MFA_TOKEN_MINUTES=5
RESET_TOKEN_MINUTES=30
UNLOCK_TOKEN_MINUTES=1440
BCRYPT_ROUNDS=12

# Brute-force protection (UC-08, UC-09, UC-10).
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=30

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used to build the links in reset / unlock emails.
FRONTEND_URL=http://localhost:5173

# Demo mode enables the one-click role switcher, the 2FA demo code and the dev email outbox.
# NEVER enable it on a public deployment.
DEMO_MODE=true
DEMO_PASSWORD=ProjectForge!1
DEMO_MFA_CODE=123456
SEED_DEMO_DATA=true
